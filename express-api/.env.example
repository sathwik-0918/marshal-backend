# Copy this file to .env and fill in real values.

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017/marshal
# Atlas later looks like:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/marshal?retryWrites=true&w=majority

# --- Clerk (Phase 3) ---
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- This server ---
PORT=5000

# --- The Python ML/agent service ---
ML_SERVICE_URL=http://localhost:8000

# --- CORS ---
CLIENT_ORIGIN=http://localhost:5173
